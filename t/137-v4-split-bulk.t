#!/usr/bin/env perl

use Test2::V1 -ipP;
use NetAddr::IP ();

my @addr = (
    [ '10.0.0.0', 20, 32, 4096 ],
    [ '10.0.0.0', 22, 32, 1024 ],
    [ '10.0.0.0', 22, 24, 4 ],
    [ '10.0.0.0', 22, 23, 2 ],
    [ '10.0.0.0', 24, 32, 256 ],
    [ '10.0.0.0', 19, 32, 8192 ],
    [ '10.0.0.0', 24, 24, 1 ],
    [ '10.0.0.0', 31, 32, 2 ],
);

for my $a (@addr) {
    my $ip = NetAddr::IP->new($a->[0], $a->[1]);
    my $r  = $ip->splitref($a->[2]);

    is(scalar @$r, $a->[3]);
}

done_testing;
