use NetAddr::IP::Lite ();
use NetAddr::IP::Util qw( addconst bcd2bin bin2bcd shiftleft );

sub badd {    # function to add a small int to bignum string
    my ($n, $i) = @_;
    my $v = bcd2bin($n);
    (undef, $v) = addconst($v, $i);
    bin2bcd($v);
}

sub xpo2 {    # function to do a n^2 multiplication
    my ($n, $x) = @_;
    my $v = bcd2bin($n);
    my $c = 0;
    while ($x >>= 1) { $c++ }
    $v = shiftleft($v, $c);
    bin2bcd($v);
}

