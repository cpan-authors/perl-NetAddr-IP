my $ptr = 0;
my $max = @exp - 11;

sub run {
    for (1 .. 5) {
        my $ip   = NetAddr::IP::Lite->new($exp[$ptr]);
        my $mbi  = $ip->bigint();
        $mbi     = $mbi + 1;
        like($mbi, qr/(?:0|$exp[$ptr + 4])/);
        $ip = NetAddr::IP::Lite->new($mbi);
        if ($exp[$ptr+1] eq '340282366920938463463374607431768211455') {
            is($ip, undef);			# 2**128 - 1 plus one does not fit in 128 bits
        }
        else {
            is($ip, $exp[$ptr + 3]);
        }
        pass('ignore mask for these tests');
        $ptr += 3;
    }
}

run();
$ptr += 3;
run();

$ptr += 3;

sub mrun {
    my $n = shift;
    for (1 .. $n) {
        my $ip = NetAddr::IP::Lite->new($exp[$ptr]);
        my ($mbia, $mbim) = $ip->bigint();
        my ($ary, $msk, $eip) = @exp[$ptr + 1, $ptr + 2, $ptr + 3];
        $ptr += 3;
        like($mbia, qr/$ary/);
        like($mbim, qr/$msk/);
        my $len = $ip->masklen();
        last unless $len;
        last if $ptr > $max + 200;    # loop stop, just in case
        $mbim = Math::BigInt->new($exp[$ptr + 2]);
        $ip = NetAddr::IP::Lite->new($mbia, $mbim);
        is($ip, $eip);
    }
}

mrun(9);

